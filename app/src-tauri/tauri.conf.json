{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fotobase",
  "version": "0.1.0",
  "identifier": "io.github.fotobase.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fotobase",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBEREFBREJDMzc3REY1NDUKUldSRjlYMDN2SzNhRFNEWTErSit6dWRjSlZ4aXlqMlhaWDQyZjJIMGpSVUR4VDIwcU13TE9SejEK",
      "endpoints": [
        "https://github.com/FotoBase/FotoBase/releases/latest/download/latest.json"
      ]
    }
  }
}
