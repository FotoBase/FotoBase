; Context menu entries (TASK-08-020): the app registers them under HKCU on
; start (src/context_menu.rs); the uninstaller removes them so none are
; orphaned. Keep the extension list in sync with associations::IMAGE_EXTS.
!macro NSIS_HOOK_POSTUNINSTALL
